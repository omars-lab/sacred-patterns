#!/usr/bin/env sh
# Cross-repo tenet 12 — defense-in-depth secret gate at PUSH time (sacred-patterns#345).
#
# The pre-commit hook scans staged hunks, so a normal `git commit` can't
# introduce a secret. This pre-push hook adds the second layer: a full-history
# scan that also catches secrets slipped in by paths the staged-hunk scan never
# sees — `commit --no-verify`, an interactive rebase that reorders/squashes, a
# merge that pulls in another branch's leak, or a hunk committed before this
# gate existed.
#
# This hook used to end "Skipped silently if gitleaks isn't installed so pushes
# still work on machines without it; CI / `make gitleaks` is the durable
# backstop." Audited 2026-07-31 and it is false twice over. There is no CI in
# this repo at all — no .github/workflows directory exists — so `make gitleaks`
# is a thing someone has to remember rather than a gate. And this repo has no
# other full-history scan, so when gitleaks is absent nothing whatsoever checks
# the history being pushed.
#
# That is the same defect the pre-commit hook's gitleaks and yq/jq branches
# already had fixed, left standing here one file over. It matters more at push
# time, not less: this is the LAST gate before the commits leave the machine,
# and a credential that reaches the remote is compromised whether or not the
# commit is later rewritten away.
#
# So it blocks, with the same named GITLEAKS_OK=1 override the pre-commit hook
# uses — the difference between choosing to skip a gate and never learning it
# did not run.
#
# `gitleaks git` rather than `gitleaks detect`: detect is deprecated and no
# longer appears in `gitleaks --help` as of 8.30.1, which lists only
# dir / git / stdin. It still runs today, but calling a retiring subcommand
# means the release that removes it takes this gate down silently.
#
# Note for whoever revisits the comment above: it previously said "Mirrors
# bikar's .husky/pre-push". That file does not exist — bikar has no active
# pre-push hook (its .githooks/ tree is stranded; core.hooksPath is .husky/_).
# bikar covers the full-history case with .github/workflows/secret-scan.yml
# instead, which is not an option here while this repo has no CI.
# gate: gitleaks-history
if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-push] gitleaks full-history scan"
  gitleaks git . --no-banner --redact || {
    echo ""
    echo "  Secret scan failed — push blocked. Inspect the finding above."
    echo "  If it's a false positive, allowlist it in .gitleaks.toml."
    exit 1
  }
elif [ "${GITLEAKS_OK:-}" = "1" ]; then
  echo "[pre-push] WARN: gitleaks full-history scan SKIPPED via GITLEAKS_OK=1."
else
  echo "[pre-push] ERROR: gitleaks not installed — history is unscanned."
  echo "           Install with: brew install gitleaks"
  echo "           There is no CI in this repo, so this blocks rather than warns."
  echo "           Deliberate override: GITLEAKS_OK=1 git push ..."
  exit 1
fi
