#!/usr/bin/env sh
# Cross-repo tenet 12: pre-commit gate prevents tenet 9 (JSDoc on exports) and
# tenet 16 (no `any` silencers) regressions from landing. Mirrors qiyas's
# planned ruff+mypy hook (qiyas#344) and bikar's planned hook (bikar#344).
#
# Only runs when staged files include .ts under src/ts/ — keeps the gate fast
# on doc-only / config-only commits.

# gate: typecheck-lint
staged_ts=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/ts/.*\.ts$' || true)

if [ -n "$staged_ts" ]; then
  echo "[pre-commit] eslint src/ts/"
  npx eslint src/ts/ || exit 1
  echo "[pre-commit] tsc --noEmit"
  npx tsc --noEmit || exit 1
fi

# Decision-memory layer: when a decision doc / tag vocab / baseline is staged,
# run the coherence gate (status-lies + unmarked reversals un-shippable), assert
# the per-repo LEDGER.md is in sync, and refresh the cross-repo roll-up. All
# read structured frontmatter keys only (no regex / no body scan). Scoped to
# docs/decisions/** so unrelated commits stay fast. Schema: docs/decision-schema.md.
# gate: decision-coherence
staged_decisions=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/decisions/' || true)
if [ -n "$staged_decisions" ]; then
  if command -v yq >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    echo "[pre-commit] check-decision-coherence (docs/decisions/ changed)"
    sh scripts/check-decision-coherence.sh || exit 1
    echo "[pre-commit] check LEDGER.md + LEDGER-XREPO.md in sync"
    sh scripts/gen-decision-ledger.sh --check || {
      echo ""
      echo "  LEDGER.md is stale. Run: sh scripts/gen-decision-ledger.sh && git add docs/decisions/LEDGER.md"
      exit 1
    }
    sh scripts/gen-decision-ledger-xrepo.sh --check || {
      echo ""
      echo "  LEDGER-XREPO.md is stale. Run: sh scripts/gen-decision-ledger-xrepo.sh && git add docs/decisions/LEDGER-XREPO.md"
      exit 1
    }
  else
    # This branch was copied from qiyas's hook, where it reads "gate runs in CI
    # regardless" — and there that is true: .github/workflows/decision-coherence.yml
    # re-runs both scripts wholesale. This repo has no .github directory at all,
    # so the same branch made the pre-commit hook the ONLY gate and then let it
    # waive itself on any machine missing a Homebrew package: all five coherence
    # rules, both LEDGER freshness checks, and Rule 0's YAML-parse guard, gone
    # without a non-zero exit anywhere. A gate that skips silently when its tools
    # are absent is a decoration.
    #
    # So it blocks. The override is named and deliberate, which is the difference
    # between choosing to skip a gate and never learning it did not run.
    if [ "${DECISION_GATE_OK:-}" = "1" ]; then
      echo "[pre-commit] WARN: decision-coherence gate SKIPPED via DECISION_GATE_OK=1."
    else
      echo "[pre-commit] ERROR: yq/jq not installed — the decision-coherence gate cannot run."
      echo "             Install with: brew install yq jq"
      echo "             There is no CI backstop in this repo, so this blocks rather than warns."
      echo "             Deliberate override: DECISION_GATE_OK=1 git commit ..."
      exit 1
    fi
  fi
fi

# The cross-repo generator's own test suite, when the generator or its test is
# staged. `--check` above already runs the generator on real data, which is
# necessary and not sufficient: it can only fail on a defect the current corpus
# happens to exhibit, and both defects this script has shipped were invisible to
# it. The uncloned-sibling one rendered a confident partial join; the working-
# tree one rendered a confident wrong row. Neither is an error state the real
# repos were in at the moment `--check` ran, which is exactly why the suite
# constructs them. Same reasoning as the two blocks above about there being no
# CI backstop in this repo, so it blocks rather than warns.
# gate: xrepo-generator-test
staged_gen=$(git diff --cached --name-only --diff-filter=ACM |
  grep -E '^scripts/gen-decision-ledger-xrepo(\.test)?\.sh$' || true)
if [ -n "$staged_gen" ]; then
  if command -v yq >/dev/null 2>&1; then
    echo "[pre-commit] gen-decision-ledger-xrepo.test.sh (generator changed)"
    sh scripts/gen-decision-ledger-xrepo.test.sh || exit 1
  elif [ "${DECISION_GATE_OK:-}" = "1" ]; then
    echo "[pre-commit] WARN: generator test suite SKIPPED via DECISION_GATE_OK=1."
  else
    echo "[pre-commit] ERROR: yq not installed — the generator's test suite cannot run."
    echo "             Install with: brew install yq"
    echo "             Deliberate override: DECISION_GATE_OK=1 git commit ..."
    exit 1
  fi
fi

# Cross-repo tenet 12 — secret scan on staged hunks (sacred-patterns#345).
# `gitleaks protect` is deprecated/broken in v8.30+: it detects leaks but
# always exits 0, defeating the gate. Use the documented post-v8 path:
# pipe `git diff --cached` into `gitleaks stdin` with explicit --exit-code 1
# (default of 1 also fails to fire on stdin in v8.30.1; pass it literally).
#
# This block used to end "Skipped silently if gitleaks isn't installed so commits
# still work on machines without it; CI / `make gitleaks` is the durable gate."
# The second half was never true here: there is no CI in this repo, so `make
# gitleaks` is a thing someone has to remember, not a gate. Same defect as the
# yq/jq branch above, one block down, and the stakes are higher — the failure
# mode is a committed secret rather than a stale ledger. It blocks, with the
# same named override.
# gate: gate-parity
# `gate-parity.yaml` says what each gate in this file looks like run over the
# whole tree, and `make local.ci` is only worth its name while that mapping is
# complete. The check runs in both directions: a `# gate:` block with no entry
# fails, and an entry naming a block that no longer exists fails.
#
# This gate is self-referential, and deliberately so — it declares itself with
# the `# gate:` line above and carries its own manifest entry. Leaving it
# unmapped would be the one hole the mapping could never see.
#
# The trigger set is everything that can move the answer: the two dispatched
# hooks, the manifest, and the checker. --diff-filter includes D because
# deleting a hook is exactly what strands its entries as STALE.
#
# There is no CI backstop in this repo, so this blocks rather than warns.
staged_gateparity=$(git diff --cached --name-only --diff-filter=ACMD |
  grep -E '^(\.husky/(pre-commit|pre-push)|gate-parity\.yaml|scripts/gate_parity\.py)$' || true)
if [ -n "$staged_gateparity" ]; then
  echo "[pre-commit] gate-parity --self-test + --check (hooks, manifest, or checker changed)"
  python3 scripts/gate_parity.py --self-test >/dev/null || {
    python3 scripts/gate_parity.py --self-test
    echo ""
    echo "  The parity checker itself no longer fails on manifests that must"
    echo "  fail. Fix the checker before trusting anything it says about the"
    echo "  hooks — there is no CI in this repo to catch it downstream."
    exit 1
  }
  python3 scripts/gate_parity.py --check || {
    echo ""
    echo "  gate-parity.yaml no longer describes what the hooks gate. Every"
    echo "  '# gate:' block needs an entry saying how to run it over the whole"
    echo "  tree (wholesale:) or why there is no such form (skip: + reason:)."
    exit 1
  }
fi

# gate: gitleaks-staged
if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks scan (staged hunks)"
  git diff --cached | gitleaks stdin --no-banner --redact --exit-code 1 || exit 1
elif [ "${GITLEAKS_OK:-}" = "1" ]; then
  echo "[pre-commit] WARN: gitleaks scan SKIPPED via GITLEAKS_OK=1."
else
  echo "[pre-commit] ERROR: gitleaks not installed — staged hunks are unscanned."
  echo "             Install with: brew install gitleaks"
  echo "             There is no CI backstop in this repo, so this blocks rather than warns."
  echo "             Deliberate override: GITLEAKS_OK=1 git commit ..."
  exit 1
fi
